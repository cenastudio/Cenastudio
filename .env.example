# =============================================================================
# TODO (operador): copie este arquivo para `.env` e/ou `.env.local` e preencha
# os segredos reais. NÃO edite `.env` local automaticamente — ele contém
# credenciais reais e o Kiro/agente evita sobrescrevê-lo. Para white label
# (Fase 3), veja o bloco "White Label" no final deste arquivo e ajuste as
# variáveis APP_* / VITE_APP_* na sua cópia local.
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# =============================================================================
# AUTHENTICATION (REQUIRED)
# =============================================================================
# JWT Secret for signing tokens (REQUIRED, min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Optional dedicated secret for signing public share links (video reviews).
# If unset, JWT_SECRET is used. Set this to isolate share links from sessions.
# Generate with: openssl rand -base64 32
SHARE_LINK_SECRET=

# Public share-link lifetimes (optional; defaults shown)
# Proposal links expire this many days after creation (accepted ones stay).
PROPOSAL_SHARE_TTL_DAYS=90
# Meeting links expire this many days after the meeting date.
MEETING_SHARE_GRACE_DAYS=2

# Admin accounts (comma-separated emails)
ADMIN_EMAILS=admin@cenastudio.com.br

# Default passwords for admin and demo users (min 12 chars in production)
ADMIN_DEFAULT_PASSWORD=
DEMO_USER_PASSWORD=

# =============================================================================
# SUPABASE CONFIGURATION (REQUIRED FOR PRODUCTION)
# =============================================================================
# Supabase project URL (format: https://<project-ref>.supabase.co)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Frontend environment variables (must have VITE_ prefix)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Development: SQLite local database
DATABASE_PATH=./data/frame.db

# Produção: ver a seção "BANCO DE DADOS" no fim deste arquivo, onde
# DATABASE_URL é declarada. Produção atual é Railway Postgres, não Supabase —
# Supabase é usado só para storage e LGPD. Ver docs/CONEXOES.md.

# Resíduo da época de deploy na Vercel. Não usados hoje; mantidos apenas para
# reconhecimento caso apareçam em ambiente antigo.
# POSTGRES_PRISMA_URL=<auto-filled-by-vercel-integration>
# POSTGRES_URL=<alternative-connection-string>

# Production safety: set only for controlled beta/testing on ephemeral hosts
ALLOW_EPHEMERAL_SQLITE=false

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================
# Choose your AI provider: openrouter, anthropic, or nvidia
AI_PROVIDER=openrouter

# -----------------------------------------------------------------------------
# OpenRouter (Free tier available - RECOMMENDED)
# -----------------------------------------------------------------------------
# Get API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free
# ATENÇÃO: MAX_TOKENS/TEMPERATURE/TOP_P abaixo valem apenas para chamadas de IA
# que NÃO vêm de uma das 12 ferramentas (ver server/services/ai/aiHelper.ts).
# Para as ferramentas, quem manda são os perfis por criticidade do ADR-014
# (`TEMPERATURE_PROFILES` e `TOOL_MAX_TOKENS` em server/services/aiService.ts).
# O 4096 abaixo é histórico e foi mantido só como referência: era ele que
# truncava o orçamento no meio do bloco `cena.budget.v1` (medição da A4.6),
# deixando a ponte para o módulo de Orçamento inerte sem erro visível.
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_TOP_P=0.95
OPENROUTER_TIMEOUT_MS=90000
OPENROUTER_FREE_LIMIT=50
FALLBACK_AI_PROVIDER=anthropic

# -----------------------------------------------------------------------------
# Anthropic (Paid - Fallback)
# -----------------------------------------------------------------------------
# Get API key: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# NVIDIA (Paid - Fallback)
# -----------------------------------------------------------------------------
# Get API key: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Alternative multimodal model:
# NVIDIA_MODEL=minimaxai/minimax-m3
NVIDIA_INVOKE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MAX_TOKENS=4096
NVIDIA_TEMPERATURE=0.7
NVIDIA_TOP_P=0.95
NVIDIA_ENABLE_THINKING=false
NVIDIA_REASONING_BUDGET=0
NVIDIA_TIMEOUT_MS=90000

# =============================================================================
# STRIPE CONFIGURATION (LEGACY/API - OPTIONAL)
# =============================================================================
# Get keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PRICE_PRO=your_stripe_pro_price_id
STRIPE_PRICE_STUDIO=your_stripe_studio_price_id

# =============================================================================
# GITHUB OAUTH (OPTIONAL)
# =============================================================================
# Create OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# =============================================================================
# CLOUDINARY CONFIGURATION (REQUIRED FOR FILE UPLOADS)
# =============================================================================
# Get credentials: https://console.cloudinary.com/settings/c-/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =============================================================================
# EMAIL CONFIGURATION (OPTIONAL — via Resend)
# =============================================================================
# Powers: password reset emails, contact/demo form notifications, and
# meeting .ics invites (client scheduling). Get a free key at resend.com
# (3,000 emails/month, no card required). Without it, these features fall
# back gracefully (no email sent, WhatsApp link still works for meetings).
RESEND_API_KEY=
EMAIL_FROM=

# =============================================================================
# WHITE LABEL — brand overridable via env (Fase 3)
# =============================================================================
# Defaults reproduzem o comportamento "Cena Studio" atual. Ajuste estes
# valores para renomear a marca sem tocar em código. Server-side lê as
# variáveis sem prefixo; o client (Vite) lê as duplicatas com prefixo
# VITE_ (Vite não expõe env vars sem esse prefixo).
#
# APP_NAME_PARTS: partes separadas por "|" que compõem a wordmark visual
# (ex.: "Cena|Studio" renderiza "Cena" + "Studio" como dois spans).
# APP_PRIMARY_COLOR: cor primária em hex (#RGB ou #RRGGBB). Inválidos
# caem para o default. Verifique contraste WCAG antes de trocar.
# APP_LOGO_URL / VITE_APP_LOGO_URL: URL pública opcional para logo em
# imagem (PNG/SVG/WebP). Se ausente, o BrandLogo renderiza wordmark.
# SUPPORT_EMAIL / VITE_SUPPORT_EMAIL: e-mail de contato exposto na UI.
APP_NAME=Cena Studio
APP_NAME_PARTS=Cena|Studio
APP_DOMAIN=cenastudio.dev
APP_PRIMARY_COLOR=#e85002
APP_LOGO_URL=
SUPPORT_EMAIL=

# Duplicatas com prefixo VITE_ para exposição no client (Vite não
# expõe env vars sem prefixo VITE_).
VITE_APP_NAME=Cena Studio
# URL pública absoluta usada em canonical e previews sociais.
VITE_PUBLIC_URL=http://localhost:5173
VITE_APP_NAME_PARTS=Cena|Studio
VITE_APP_DOMAIN=cenastudio.dev
VITE_APP_PRIMARY_COLOR=#e85002
VITE_APP_LOGO_URL=
VITE_SUPPORT_EMAIL=

# =============================================================================
# BANCO DE DADOS — obrigatório
# =============================================================================
# Produção roda Railway Postgres. DATABASE_URL é a única string de conexão
# realmente usada pelo Prisma; as variantes POSTGRES_* mais abaixo são resíduo
# da época de Vercel e permanecem comentadas.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# Detalhes de cada provedor e como reconectar: docs/CONEXOES.md
DATABASE_URL=

# Pool e resiliência de conexão (todos opcionais — os defaults do código
# servem para desenvolvimento local; ver server/models/db.ts).
DATABASE_POOL_MAX=
DATABASE_CONNECT_TIMEOUT_MS=
DATABASE_IDLE_TIMEOUT_MS=
DATABASE_TRANSIENT_RETRIES=

# =============================================================================
# SUPABASE — storage e LGPD
# =============================================================================
# SUPABASE_URL e SUPABASE_ANON_KEY já estão declarados acima.
# A service role key é necessária para operações administrativas de storage
# (exportação e exclusão de dados por LGPD). NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY=
# Alias aceito pelo código como fallback de SUPABASE_SERVICE_ROLE_KEY.
# SUPABASE_SECRET_KEY=
# Alias aceito pelo código como fallback de SUPABASE_URL (resíduo de Next.js).
# NEXT_PUBLIC_SUPABASE_URL=
# Bucket usado para uploads. Se ausente, o código usa o default interno.
SUPABASE_STORAGE_BUCKET=

# =============================================================================
# LIMITES DE UPLOAD
# =============================================================================
# Em megabytes. Ausentes = default do código.
MAX_UPLOAD_SIZE_MB=
MAX_VIDEO_SIZE_MB=

# =============================================================================
# STRIPE — preços anuais
# =============================================================================
# Os price IDs mensais já estão declarados acima. Estes são os anuais.
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_STUDIO_ANNUAL=

# =============================================================================
# LGPD
# =============================================================================
# Dias de carência entre a solicitação de exclusão e a remoção efetiva.
LGPD_DELETE_GRACE_DAYS=

# =============================================================================
# ADMIN
# =============================================================================
# "true" exige segundo fator para rotas administrativas.
ADMIN_REQUIRE_2FA=

# =============================================================================
# OBSERVABILIDADE
# =============================================================================
# error | warn | info | debug
LOG_LEVEL=

# =============================================================================
# FRONTEND (Vite)
# =============================================================================
# Base da API consumida pelo client. Vazio = mesma origem.
VITE_API_URL=
# Título de SEO. Server-side lê APP_SEO_TITLE; o client exige o prefixo VITE_.
APP_SEO_TITLE=
VITE_APP_SEO_TITLE=

# =============================================================================
# SCRIPTS DE VERIFICAÇÃO (não usar em produção)
# =============================================================================
# Credenciais de uma conta de teste, consumidas pelos scripts de smoke test e
# de captura de screenshots da landing. Deixe vazio em produção.
SMOKE_BASE_URL=
SMOKE_EMAIL=
SMOKE_PASSWORD=
LANDING_CAPTURE_BASE_URL=
LANDING_CAPTURE_EMAIL=
LANDING_CAPTURE_PASSWORD=

# =============================================================================
# DEFINIDAS PELA PLATAFORMA — não declarar aqui
# =============================================================================
# VERCEL: injetada automaticamente quando o build roda na Vercel. O código a
# usa apenas para desligar comportamentos específicos de servidor persistente.
# Produção atual é Railway, onde esta variável não existe.
