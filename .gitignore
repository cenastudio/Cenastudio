*.sh
!scripts/**/*.sh
limpar-*.sh
remover-*.sh
PUSH_*.sh

# Temporários de sessão de debug/diagnóstico (ex.: scripts descartáveis
# criados com prefixo _ para consultas pontuais no banco, dumps de
# verificação, etc. — nunca fazem parte do código do projeto).
/_*.mjs
/_*.ts
/_*.txt
/_*.json
cookies.txt
.checkout.txt
add-progress-column.sql
supabase-rls-policies.sql

# Pastas internas (conteúdo local, não versionado)
skills/

# docs/ é parcialmente versionada: design-system/ e white-label/ são
# documentação técnica real. archive/, history/ e troubleshooting/ são
# scratch de sessões passadas (notion dumps, checklists pontuais) e não
# devem virar parte permanente do repo.
docs/archive/
docs/history/
docs/troubleshooting/
.vercel
